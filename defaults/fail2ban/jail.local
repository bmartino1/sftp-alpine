[DEFAULT]
# Source of truth for bundled SSH jails. Site allowlists belong in persistent /config.
ignoreip = 127.0.0.1/8 ::1
findtime = 600
maxretry = 3
bantime = 3600
bantime.increment = true
backend = polling
usedns = no
logencoding = auto
# Default firewall backend: override explicitly to nftables-multiport when verified.
banaction = iptables-multiport
banaction_allports = iptables-allports
# Ban enforcement runs first; WHOIS is supplemental reporting.
action = %(banaction)s[name=%(__name__)s, port="%(port)s", protocol="tcp"]
         logwhois[logpath=/config/log/whois.log]

[sshd]
enabled = true
port = 22
filter = sshd
logpath = /config/log/auth.log
maxretry = 3
findtime = 600
bantime = 3600

[sshd-cipher-mismatch]
enabled = true
port = 22
filter = sshd-cipher-mismatch
logpath = /config/log/auth.log
maxretry = 1
findtime = 3600
bantime = 86400

[sshd-banner-fail]
enabled = true
port = 22
filter = sshd-banner-fail
logpath = /config/log/auth.log
maxretry = 1
findtime = 3600
bantime = 86400

[recidive]
enabled = true
logpath = /config/log/fail2ban.log
filter = recidive
port = 0:65535
banaction = %(banaction_allports)s
# Keep router-level ban logging distinct from action enforcement.
action = %(banaction_allports)s[name=%(__name__)s, protocol="tcp"]
         logwhois[logpath=/config/log/whois.log]
findtime = 86400
bantime = 604800
maxretry = 3
